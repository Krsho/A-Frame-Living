RewriteEngine On

# Never serve these folders directly: configuration (passwords), logs,
# the database file and installed packages.
RewriteRule ^(config|logs|database|vendor)(/|$) - [F,L]

# Apache (e.g. XAMPP): send every request that is not a real file to index.php,
# so FlightPHP can match it to a route (e.g. /houses/norway).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
